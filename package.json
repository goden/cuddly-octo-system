{
  "name": "cluddy-octo-system",
  "displayName": "Team Java 8 & TS Agent Skills.",
  "version": "1.0.0",
  "description": "VS Code Custom Agent Skills for Java 8 and TypeScript Development",
  "publisher": "Gordon",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onLanguage:java",
    "onLanguage:typescript"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languageModelTools": [
      {
        "name": "run_java8_maven_test",
        "displayName": "Java 8 Maven Test Runner",
        "modelDescription": "當使用者要求執行或驗證特定的 Java 8 單元測試時調用此工具。能執行 mvn test 並回傳失敗案例與 Error Stack Trace。",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "mavenTest",
        "inputSchema": {
          "type": "object",
          "properties": {
            "testClass": {
              "type": "string",
              "description": "要執行的 Java 測試類別名稱，例如 UserServiceTest"
            }
          },
          "required": [
            "testClass"
          ]
        }
      },
      {
        "name": "check_ts_strict",
        "displayName": "TypeScript Strict Mode Checker",
        "modelDescription": "當使用者要求檢查 TypeScript 檔案是否符合 strict 模式時調用此工具。能檢查 tsconfig.json 設定與程式碼中可能違反 strict 模式的部分。",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "tsStrictCheck",
        "inputSchema": {
          "type": "object",
          "properties": {
            "filePath": {
              "type": "string",
              "description": "要檢查的 TypeScript 檔案路徑，例如 src/app.ts"
            }
          },
          "required": [
            "filePath"
          ]
        }
      }
    ]
  },
  "homepage": "https://github.com/goden/cuddly-octo-system#readme",
  "bugs": {
    "url": "https://github.com/goden/cuddly-octo-system/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/goden/cuddly-octo-system.git"
  },
  "license": "ISC",
  "author": "Gordon",
  "type": "commonjs",
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "build-vsix": "npx vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}
